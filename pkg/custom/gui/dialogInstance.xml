<form>
    <field>
        <id>instance.enabled</id>
        <label>Enable</label>
        <type>checkbox</type>
        <help>Activate this OpenConnect connection.</help>
        <grid_view>
            <width>6em</width>
            <type>boolean</type>
            <formatter>rowtoggle</formatter>
            <sequence>10</sequence>
        </grid_view>
    </field>
    <field>
        <id>instance.name</id>
        <label>Name</label>
        <type>text</type>
        <help>A short label for this connection (used in interface descriptions).</help>
        <grid_view>
            <sequence>20</sequence>
        </grid_view>
    </field>
    <field>
        <id>instance.server</id>
        <label>VPN Server</label>
        <type>text</type>
        <help>The FQDN or IP address (optionally :port) of the VPN server.</help>
        <grid_view>
            <sequence>30</sequence>
        </grid_view>
    </field>
    <field>
        <id>instance.user</id>
        <label>Username</label>
        <type>text</type>
        <help>The user name for this connection.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>instance.password</id>
        <label>Password</label>
        <type>password</type>
        <help>The password for this connection. Stored in cleartext on this device.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>instance.interface</id>
        <label>Interface id</label>
        <type>text</type>
        <help>Optional. The ocvpn group interface for this tunnel, e.g. ocvpn1. Auto-assigned if empty.</help>
        <grid_view>
            <sequence>50</sequence>
        </grid_view>
    </field>
    <field>
        <id>instance.protocol</id>
        <label>Protocol</label>
        <type>dropdown</type>
        <help>Select the protocol to use.</help>
        <grid_view>
            <sequence>40</sequence>
        </grid_view>
    </field>
    <field>
        <id>instance.group</id>
        <label>Group Name</label>
        <type>text</type>
        <advanced>Y</advanced>
        <help>When using profiles for group separation please set here.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>instance.servercert</id>
        <label>Certificate Hash</label>
        <type>text</type>
        <advanced>Y</advanced>
        <help>If you have a wildcard certificate or the CA is untrusted, enter the hash of the certificate to force a connect.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>instance.hash</id>
        <label>Certificate Hash Type</label>
        <type>dropdown</type>
        <advanced>Y</advanced>
        <help>Select the type of hash.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>instance.clientcertificate</id>
        <label>Client Certificate</label>
        <type>dropdown</type>
        <advanced>Y</advanced>
        <help>Select the client certificate to use.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>instance.tokenmode</id>
        <label>Token Mode</label>
        <type>dropdown</type>
        <advanced>Y</advanced>
        <help>Use a one-time password generation mode.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>instance.tokensecret</id>
        <label>Token Secret</label>
        <type>text</type>
        <advanced>Y</advanced>
        <help>Enter a secret to use with one-time password generation.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
    <field>
        <id>instance.allowinsecure</id>
        <label>Allow Insecure Ciphers</label>
        <type>checkbox</type>
        <advanced>Y</advanced>
        <help>This option allows the use of insecure ciphers.</help>
        <grid_view>
            <ignore>true</ignore>
        </grid_view>
    </field>
</form>
